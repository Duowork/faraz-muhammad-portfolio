{
  "name": "faraz-muhammad-site",
  "private": true,
  "version": "0.1.0",
  "description": "Portfolio and gallery for Faraz Muhammad, fashion and multidisciplinary creative.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "predev": "npm run images",
    "dev": "vite",
    "prebuild": "npm run images",
    "build": "vite build",
    "preview": "vite preview",
    "images": "node scripts/optimize-images.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "jsdom": "^29.1.1",
    "opentype.js": "^2.0.0",
    "prettier": "^3.10.1",
    "sharp": "^0.35.5",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  },
  "overrides": {
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  }
}
