# Public, non-secret build settings. Every VITE_ value ends up in the browser bundle.
# Put real values in .env.local (git-ignored) or in your host's environment settings.

# Sub-path the site is served from. Leave empty for a domain root or custom domain.
# For a GitHub Pages project site (https://<user>.github.io/<repo>/) set it to /<repo>/.
# Build-time only; not exposed to the browser.
BASE_PATH=/faraz-muhammad-portfolio/

# Absolute site URL including any sub-path, no trailing slash. Used for the Open Graph image,
# e.g. https://example.com or https://<user>.github.io/<repo>
VITE_SITE_URL=https://duowork.github.io/faraz-muhammad-portfolio

# Endpoint that accepts a JSON POST and forwards it by email (e.g. a Formspree form URL).
# Until it is set, the Inquire and Contact forms show a "not connected yet" message.
VITE_FORM_ENDPOINT=