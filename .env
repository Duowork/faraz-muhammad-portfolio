# Public, non-secret build settings. Every VITE_ value ends up in the browser bundle.
# Put real values in .env.local (git-ignored) or in your host's environment settings.

# Absolute site URL, no trailing slash. Used for the Open Graph image, e.g. https://example.com
VITE_SITE_URL=

# Endpoint that accepts a JSON POST and forwards it by email (e.g. a Formspree form URL).
# Until it is set, the Inquire and Contact forms show a "not connected yet" message.
VITE_FORM_ENDPOINT=
